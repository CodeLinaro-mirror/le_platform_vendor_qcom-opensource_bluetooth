android_app {
    name: "offload_testapp",

    srcs: [
        "src/*.java",
    ],
    exclude_srcs: [
       "src/GattClientqabt.java",
       "src/ThroughputStateMachineqabt.java",
       "src/SocketServerqabt.java",
       "src/GattServerqabt.java",
    ],
    certificate: ":com.android.bluetooth.certificate",
    privileged: true,
    required: ["privapp-permission-offload.xml"],

    owner: "qti",

    static_libs: [
        "androidx.legacy_legacy-support-v13",
        "androidx.appcompat_appcompat",
        "android.hardware.contexthub-V4-java",
    ],
    optimize: {
        enabled: false,
    },
    platform_apis: true,
 }
prebuilt_etc {
    name: "privapp-permission-offload.xml",
    src: "privapp-permission-lecoc.xml",
    sub_dir: "permissions",
  }
