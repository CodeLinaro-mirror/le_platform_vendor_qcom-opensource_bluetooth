<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/activity_horizontal_margin"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="100dip"
            android:layout_weight="1"
            android:layout_margin="@dimen/activity_base_margin"
            style="@style/textview_normal" />
        <Button
            android:id="@+id/abort"
            android:layout_width="wrap_content"
            android:layout_height="100dip"
            android:layout_weight="1"
            android:layout_margin="@dimen/activity_base_margin"
            style="@style/textview_normal"
            android:text="@string/map_abort"/>
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/maptest_viewflipper"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <!-- Browsing Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/get_unread_messages"
                    android:layout_width="wrap_content"
                    android:layout_height="50dip"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/activity_base_margin"
                    style="@style/textview_normal"
                    android:text="@string/map_get_unread_messages"/>
                <Button
                    android:id="@+id/filter"
                    android:layout_width="wrap_content"
                    android:layout_height="50dip"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/activity_base_margin"
                    style="@style/textview_normal"
                    android:text="@string/map_filter"/>
            </LinearLayout>

            <!-- Messages layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#000030" >
                <ListView
                    android:id="@+id/msglist_lv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical" >
                    <ProgressBar
                        android:id="@+id/msglist_progressbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="?android:attr/progressBarStyleLarge"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/msglist_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_messages_empty"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout><!-- End Browsing Layout -->

        <!-- Push layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusableInTouchMode="true"
            android:orientation="vertical" >

            <!-- edit recipient, prefill the content, send message -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- recipient -->
                <TextView
                    android:id="@+id/map_push_rcpt_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/map_push_recipient_prompt" />
                <EditText
                    android:id="@+id/map_push_rcpt_edit"
                    android:layout_width="200dip"
                    android:layout_height="wrap_content"/>

                <!-- prefill len -->
                <TextView
                    android:id="@+id/map_push_prefill_len_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/map_push_prefill_len_prompt" />

                <EditText
                    android:id="@+id/map_push_prefill_len_edit"
                    android:numeric="integer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Spinner
                    android:id="@+id/push_message_type_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/array_send_message_type" />

                <!-- prefill content -->
                <Button
                    android:id="@+id/map_push_prefill"
                    android:layout_width="wrap_content"
                    android:layout_height="50dip"
                    android:text="@string/map_push_prefill_content"/>

                <!-- push message -->
                <Button
                    android:id="@+id/map_push"
                    android:layout_width="wrap_content"
                    android:layout_height="50dip"
                    android:text="@string/map_push_msg"/>
            </LinearLayout>

            <!-- message contents -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dip"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/map_push_content_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/map_push_content_prompt" />
                <EditText
                    android:id="@+id/map_push_content_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:typeface="monospace"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:background="#000030"
                    style="@style/somePadding"/>
            </LinearLayout>
        </LinearLayout><!-- End push layout -->
    </ViewFlipper>
</LinearLayout>
