<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE Set PHY"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/phy_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="13sp"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- ================================================================ -->
        <!-- Device Selection                                                  -->
        <!-- ================================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/device_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/refresh_devices_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/connect_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- ================================================================ -->
        <!-- TX PHY                                                            -->
        <!-- ================================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TX PHY (bitmask — select one or more)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <CheckBox
                android:id="@+id/tx_phy_1m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1M\n(bit 0)" />

            <CheckBox
                android:id="@+id/tx_phy_2m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2M\n(bit 1)" />

            <CheckBox
                android:id="@+id/tx_phy_hdt2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT2\n(bit 2)" />

            <CheckBox
                android:id="@+id/tx_phy_hdt3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT3\n(bit 3)" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/tx_phy_hdt4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT4\n(bit 4)" />

            <CheckBox
                android:id="@+id/tx_phy_hdt6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT6\n(bit 5)" />

            <CheckBox
                android:id="@+id/tx_phy_hdt75"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT7.5\n(bit 6)" />

            <!-- Spacer to keep alignment with the row above -->
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ================================================================ -->
        <!-- RX PHY                                                            -->
        <!-- ================================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RX PHY (bitmask — select one or more)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <CheckBox
                android:id="@+id/rx_phy_1m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1M\n(bit 0)" />

            <CheckBox
                android:id="@+id/rx_phy_2m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2M\n(bit 1)" />

            <CheckBox
                android:id="@+id/rx_phy_hdt2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT2\n(bit 2)" />

            <CheckBox
                android:id="@+id/rx_phy_hdt3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT3\n(bit 3)" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/rx_phy_hdt4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT4\n(bit 4)" />

            <CheckBox
                android:id="@+id/rx_phy_hdt6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT6\n(bit 5)" />

            <CheckBox
                android:id="@+id/rx_phy_hdt75"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HDT7.5\n(bit 6)" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ================================================================ -->
        <!-- PHY Options                                                       -->
        <!-- ================================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHY Options"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/phy_options_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- ================================================================ -->
        <!-- Action Buttons                                                    -->
        <!-- ================================================================ -->
        <Button
            android:id="@+id/set_phy_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set PHY"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/read_phy_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Read PHY"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
