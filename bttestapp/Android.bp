android_app {
    name: "BTTestApp",
    system_ext_specific: true,

    srcs: [
        "src/**/*.java",
    ],

    exclude_srcs: [
        "src/org/codeaurora/bluetooth/bttestapp/services/IMapServiceCallback.java",
    ],

    static_libs: [
        "com.android.vcard",
    ],

    certificate: "platform",

    owner: "qti",

    optimize: {
        enabled: false,
    },
    platform_apis: true,
}
